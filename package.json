{
  "name": "nest",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run prisma:generate",
    "dev": "next dev",
    "test": "node --import tsx --test tests/*.test.mjs",
    "ai:eval": "node scripts/evaluate-ask-nest.mjs",
    "test:ui": "node --test tests/ui-contract.test.mjs",
    "prebuild": "npm run prisma:generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run lint && npm run typecheck && npm test",
    "audit:public": "node scripts/audit-public-readiness.mjs && npm audit --omit=dev --audit-level=high",
    "prisma:generate": "node scripts/run-prisma.mjs generate",
    "prisma:migrate": "node scripts/run-prisma.mjs migrate dev",
    "prisma:migrate:deploy": "node scripts/run-prisma.mjs migrate deploy",
    "prisma:seed": "node prisma/seed.mjs",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "vapid:generate": "node scripts/generate-vapid-keys.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@azure/communication-email": "^1.1.0",
    "@azure/core-auth": "1.11.0",
    "@azure/identity": "^4.13.1",
    "@azure/search-documents": "^13.0.0",
    "@prisma/client": "^6.16.3",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@tanstack/react-query": "^5.101.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "next-auth": "^4.24.15",
    "openai": "^6.48.0",
    "prisma": "^6.16.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "simple-icons": "^16.27.0",
    "swagger-ui-react": "^5.32.9",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "js-yaml": "4.3.0",
    "postcss": "8.5.20"
  }
}
