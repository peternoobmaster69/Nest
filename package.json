{
  "name": "nest",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-argparse-compatibility.mjs",
    "predev": "npm run prisma:generate",
    "dev": "node scripts/run-next-with-system-ca.mjs dev",
    "test": "node --experimental-test-module-mocks --import tsx --test tests/*.test.mjs",
    "test:coverage": "c8 npm test",
    "coverage:check": "node scripts/sonar.mjs coverage",
    "sonar": "npm run test:coverage && npm run sonar:scan",
    "sonar:scan": "node scripts/sonar.mjs scan",
    "sonar:configure": "node scripts/sonar.mjs configure",
    "sonar:verify": "node scripts/sonar.mjs verify",
    "test:integration": "node --import tsx --test tests/*.integration.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "ai:eval": "node scripts/evaluate-ask-nest.mjs",
    "ai:eval:agents": "node --import tsx scripts/evaluate-agent-prompts.mjs",
    "ai:prompts:upgrade": "node --env-file=.env --import tsx scripts/upgrade-agent-prompts.mjs",
    "test:ui": "node --test tests/ui-contract.test.mjs",
    "ui:check": "node scripts/check-phase7-ui.mjs",
    "ux:check": "node --test tests/phase8-product-ux.test.mjs",
    "ui:metrics": "node scripts/report-ui-performance.mjs",
    "ui:metrics:check": "node scripts/report-ui-performance.mjs --check",
    "ui:metrics:baseline": "node scripts/report-ui-performance.mjs --write-baseline",
    "prebuild": "npm run prisma:generate",
    "build": "node scripts/run-next-with-system-ca.mjs build",
    "start": "node scripts/run-next-with-system-ca.mjs start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run ui:check && npm run lint && npm run typecheck && npm run openapi:check && npm test",
    "prisma:validate": "node scripts/run-prisma.mjs validate",
    "openapi:generate": "node --import tsx scripts/generate-openapi.mjs",
    "openapi:check": "node --import tsx scripts/generate-openapi.mjs --check",
    "audit:public": "node scripts/audit-public-readiness.mjs && npm audit --omit=dev --audit-level=high",
    "audit:strict": "npm audit --audit-level=low",
    "prisma:generate": "node scripts/run-prisma.mjs generate",
    "prisma:migrate": "node scripts/run-prisma.mjs migrate dev",
    "prisma:migrate:deploy": "node scripts/run-prisma.mjs migrate deploy",
    "prisma:seed": "node prisma/seed.mjs",
    "db:bootstrap": "node scripts/bootstrap-database.mjs",
    "db:phase4:preflight": "node scripts/check-phase4-preflight.mjs",
    "db:phase4:domain-report": "node scripts/report-phase4-domain-values.mjs",
    "db:migration:report": "node scripts/report-migration-state.mjs",
    "db:migration:dry-run": "node scripts/dry-run-sql-migration.mjs",
    "banks:cache-logos": "node --import tsx scripts/cache-bank-logos.mjs",
    "legacy:import-kf-miles": "node scripts/import-kf-miles.mjs",
    "legacy:reconcile-ff-balances": "node scripts/reconcile-ff-balances.mjs",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "vapid:generate": "node scripts/generate-vapid-keys.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@azure/communication-email": "^1.1.0",
    "@azure/core-auth": "1.10.1",
    "@azure/identity": "^4.13.1",
    "@azure/search-documents": "^13.0.0",
    "@prisma/client": "^6.16.3",
    "@react-pdf/renderer": "^4.5.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@tanstack/react-query": "^5.90.21",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.7.0",
    "next": "^16.3.3",
    "next-auth": "^4.24.15",
    "openai": "^6.47.0",
    "prisma": "^6.16.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "swagger-ui-react": "^5.32.11",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "c8": "12.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "happy-dom": "^20.14.5",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.15"
    },
    "@simplewebauthn/server": "$@simplewebauthn/server",
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "js-yaml": "4.3.2",
    "postcss": "8.5.23",
    "remarkable": {
      "argparse": "2.0.1"
    },
    "source-map-js": "1.2.2",
    "sharp": "$sharp"
  }
}
