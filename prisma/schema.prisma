generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "sqlserver"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  relationMode      = "prisma"
}

model User {
  id                       String                    @id @default(cuid())
  email                    String?                   @unique
  emailVerified            DateTime?
  name                     String?
  image                    String?
  activeWorkspaceId        String?
  sessionVersion           Int                       @default(0)
  activeSessionId          String?
  activeSessionExpiresAt   DateTime?
  lastSignedInAt           DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  accounts                 Account[]
  sessions                 Session[]
  loginSessions            LoginSession[]
  memberships              WorkspaceMember[]
  budgets                  BudgetEnvelope[]          @relation("BudgetCreatedBy")
  receivablesFrom          Receivable[]              @relation("ReceivableFrom")
  receivablesTo            Receivable[]              @relation("ReceivableTo")
  notes                    Note[]
  gmailIntegrations        GmailIntegration[]
  inAppNotifications       InAppNotification[]
  sentWorkspaceInvites     WorkspaceInvite[]         @relation("WorkspaceInviteSender")
  receivedWorkspaceInvites WorkspaceInvite[]         @relation("WorkspaceInviteReceiver")
  workspaceAuditLogs       WorkspaceAuditLog[]
  budgetSources            BudgetSource[]
  monthlyBudgetSources     MonthlyBudgetSource[]
  monthlyBudgetPlanSources MonthlyBudgetPlanSource[]
  passkeys                 PasskeyCredential[]
  webAuthnChallenges       WebAuthnChallenge[]
  pushSubscriptions        PushSubscription[]
  askNestTurns             AskNestTurn[]
  askNestMemories          AskNestMemory[]
  askNestUsageDaily        AskNestUsageDaily[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.NVarChar(Max)
  access_token      String? @db.NVarChar(Max)
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.NVarChar(Max)
  session_state     String? @db.NVarChar(Max)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginSession {
  id          String   @id @default(cuid())
  sessionId   String   @unique @db.VarChar(64)
  userId      String
  provider    String?  @db.VarChar(64)
  ipAddress   String?  @db.VarChar(45)
  countryCode String?  @db.VarChar(2)
  signedInAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, signedInAt])
  @@index([signedInAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id                         String                  @id @default(cuid())
  name                       String
  baseCurrency               String                  @default("SGD")
  receivableDefaultAccountId String?
  receivableDefaultBudgetId  String?
  isShared                   Boolean                 @default(false)
  sidebarMoneyPages          String? // Stores visibility settings for Money section pages in sidebar (JSON string)
  creditCardAutoRules        String?                 @db.NVarChar(Max) // Stores ordered credit card auto-accounting rules (JSON string)
  publicNetWorthEnabled      Boolean                 @default(false)
  publicNetWorthToken        String?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  receivableDefaultAccount   FinancialAccount?       @relation("WorkspaceReceivableDefaultAccount", fields: [receivableDefaultAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receivableDefaultBudget    BudgetEnvelope?         @relation("WorkspaceReceivableDefaultBudget", fields: [receivableDefaultBudgetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members                    WorkspaceMember[]
  months                     Month[]
  accountTypes               AccountType[]
  financials                 FinancialAccount[]
  budgetEnvelopes            BudgetEnvelope[]
  transactions               Transaction[]
  creditCards                CreditCardAccount[]
  receivables                Receivable[]
  noteLists                  NoteList[]
  notes                      Note[]
  salaryEntries              SalaryEntry[]
  usdAccounts                UsdAccountEntry[]
  usdInvestments             UsdInvestmentEntry[]
  milePrograms               MileProgram[]
  mileRedemptions            MileRedemption[]
  frequentFlyerAccounts      FrequentFlyerAccount[]
  hotelRewardAccounts        HotelRewardAccount[]
  creditCardRewards          CreditCardReward[]
  pointConversions           PointConversion[]
  creditCardTransactions     CreditCardTransaction[]
  cardAlertStagings          CardAlertStaging[]
  gmailIntegrations          GmailIntegration[]
  investmentAccounts         InvestmentAccount[]
  invites                    WorkspaceInvite[]
  auditLogs                  WorkspaceAuditLog[]
  budgetItems                BudgetItem[]
  budgetSources              BudgetSource[]
  monthlyBudgetSources       MonthlyBudgetSource[]
  monthlyBudgets             MonthlyBudget[]
  monthlyBudgetPlans         MonthlyBudgetPlan[]
  inAppNotifications         InAppNotification[]
  transactionGroups          TransactionGroup[]
  askNestTurns               AskNestTurn[]
  askNestMemories            AskNestMemory[]
  askNestUsageDaily          AskNestUsageDaily[]

  @@index([publicNetWorthToken])
}

model WorkspaceInvite {
  id            String    @id @default(cuid())
  workspaceId   String
  invitedEmail  String
  invitedById   String
  invitedUserId String?
  role          String    @default("VIEWER")
  tokenHash     String?   @db.VarChar(64)
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now())
  expiresAt     DateTime?
  respondedAt   DateTime?
  revokedAt     DateTime?
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy     User      @relation("WorkspaceInviteSender", fields: [invitedById], references: [id], onDelete: NoAction)
  invitedUser   User?     @relation("WorkspaceInviteReceiver", fields: [invitedUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([invitedEmail, status])
  @@index([tokenHash])
}

model WorkspaceAuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  actorUserId String?
  action      String
  details     String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorUser   User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

model InvestmentAccount {
  id              String            @id @default(cuid())
  workspaceId     String
  displayName     String?
  institutionName String
  productName     String
  inceptionDate   DateTime
  divestedDate    DateTime?
  isLiquid        Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries         InvestmentEntry[]

  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt])
}

model InvestmentEntry {
  id                String            @id @default(cuid())
  accountId         String
  date              DateTime
  investedCents     Int
  currentValueCents Int
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  account           InvestmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, date])
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("VIEWER")
  invitedBy   String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model SecurityRateLimit {
  keyHash         String    @id @db.VarChar(64)
  count           Int       @default(0)
  windowStartedAt DateTime
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([updatedAt])
}

model IntegrationOAuthState {
  tokenHash    String   @id @db.VarChar(64)
  userId       String
  workspaceId  String
  pkceVerifier String   @db.NVarChar(Max)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

model Month {
  id          String       @id @default(cuid())
  workspaceId String
  label       String
  year        Int
  month       Int
  sortOrder   Int
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  receivables Receivable[]

  @@unique([workspaceId, year, month])
  @@unique([workspaceId, id])
  @@index([workspaceId, sortOrder])
}

model AccountType {
  id          String             @id @default(cuid())
  workspaceId String
  label       String
  sortOrder   Int                @default(0)
  isActive    Boolean            @default(true)
  color       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  accounts    FinancialAccount[]

  @@unique([workspaceId, label])
}

model FinancialAccount {
  id                             String           @id @default(cuid())
  workspaceId                    String
  accountTypeId                  String?
  name                           String
  bankName                       String?
  kind                           String
  description                    String?
  startingCents                  Int              @default(0)
  isFromFamily                   Boolean          @default(false)
  isActive                       Boolean          @default(true)
  isSynced                       Boolean          @default(false)
  createdAt                      DateTime         @default(now())
  updatedAt                      DateTime         @updatedAt
  workspace                      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  accountType                    AccountType?     @relation(fields: [accountTypeId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  receivableDefaultForWorkspaces Workspace[]      @relation("WorkspaceReceivableDefaultAccount")
  transactions                   Transaction[]
  budgets                        BudgetEnvelope[]
  receivables                    Receivable[]

  @@unique([workspaceId, id])
  @@index([workspaceId, kind])
}

model BudgetEnvelope {
  id                             String                  @id @default(cuid())
  workspaceId                    String
  accountId                      String
  name                           String
  icon                           String?
  targetCents                    Int                     @default(0)
  availableCents                 Int                     @default(0)
  isActive                       Boolean                 @default(true)
  createdById                    String
  createdAt                      DateTime                @default(now())
  updatedAt                      DateTime                @updatedAt
  workspace                      Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account                        FinancialAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy                      User                    @relation("BudgetCreatedBy", fields: [createdById], references: [id], onDelete: NoAction)
  receivableDefaultForWorkspaces Workspace[]             @relation("WorkspaceReceivableDefaultBudget")
  incomingBudgetItems            BudgetItem[]
  incomingMonthlyBudgetPlanItems MonthlyBudgetPlanItem[]
  expenseTypes                   ExpenseType[]
  transactions                   Transaction[]
  transactionGroups              TransactionGroup[]
  receivables                    Receivable[]

  @@unique([workspaceId, id])
  @@index([workspaceId, accountId])
}

// Budget Items for funding sub-accounts
model BudgetItem {
  id                      String                  @id @default(cuid())
  workspaceId             String
  title                   String
  amountCents             Int                     @default(0)
  isMonthly               Boolean                 @default(true)
  destinationSubAccountId String?
  sortOrder               Int                     @default(0)
  isActive                Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  workspace               Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  destinationSubAccount   BudgetEnvelope?         @relation(fields: [destinationSubAccountId], references: [id], onDelete: SetNull)
  monthlyBudgets          MonthlyBudget[]
  monthlyBudgetPlanItems  MonthlyBudgetPlanItem[]

  @@unique([workspaceId, id])
  @@index([workspaceId])
}

// Budget Sources (funding sources)
model BudgetSource {
  id                       String                    @id @default(cuid())
  workspaceId              String
  title                    String
  ownerId                  String // Links to User (workspace member) who owns this source
  amountCents              Int                       @default(0)
  isActive                 Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  workspace                Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner                    User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  monthlyBudgets           MonthlyBudget[]
  monthlyBudgetSources     MonthlyBudgetSource[]
  monthlyBudgetPlanSources MonthlyBudgetPlanSource[]

  @@unique([workspaceId, id])
  @@index([workspaceId])
}

model MonthlyBudgetSource {
  id             String       @id @default(cuid())
  workspaceId    String
  budgetSourceId String
  year           Int
  month          Int
  title          String
  ownerId        String
  amountCents    Int          @default(0)
  isDraft        Boolean      @default(true)
  confirmedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  budgetSource   BudgetSource @relation(fields: [budgetSourceId], references: [id], onDelete: Cascade)
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, year, month, budgetSourceId])
  @@index([workspaceId, year, month])
}

// Monthly generated budget entries
model MonthlyBudget {
  id                      String       @id @default(cuid())
  workspaceId             String
  budgetItemId            String
  budgetSourceId          String
  year                    Int
  month                   Int // 1-12
  budgetItemTitle         String?
  budgetSourceTitle       String?
  destinationSubAccountId String?
  allocatedCents          Int          @default(0)
  isDraft                 Boolean      @default(true) // true until user confirms
  confirmedAt             DateTime? // set when user confirms
  appliedAt               DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  workspace               Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  budgetItem              BudgetItem   @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)
  budgetSource            BudgetSource @relation(fields: [budgetSourceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, year, month, budgetItemId, budgetSourceId])
  @@index([workspaceId, year, month])
}

model MonthlyBudgetPlan {
  id          String                    @id @default(cuid())
  workspaceId String
  year        Int
  month       Int
  status      String                    @default("DRAFT")
  confirmedAt DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  workspace   Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sources     MonthlyBudgetPlanSource[]
  items       MonthlyBudgetPlanItem[]

  @@unique([workspaceId, year, month])
  @@index([workspaceId, status])
}

model MonthlyBudgetPlanSource {
  id               String            @id @default(cuid())
  planId           String
  templateSourceId String?
  title            String
  ownerId          String
  amountCents      Int               @default(0)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  plan             MonthlyBudgetPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  templateSource   BudgetSource?     @relation(fields: [templateSourceId], references: [id], onDelete: SetNull)
  owner            User              @relation(fields: [ownerId], references: [id], onDelete: NoAction)

  @@index([planId, sortOrder])
  @@index([templateSourceId])
  @@index([ownerId])
}

model MonthlyBudgetPlanItem {
  id                      String            @id @default(cuid())
  planId                  String
  templateItemId          String?
  title                   String
  amountCents             Int               @default(0)
  destinationSubAccountId String?
  sortOrder               Int               @default(0)
  appliedCents            Int               @default(0)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  plan                    MonthlyBudgetPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  templateItem            BudgetItem?       @relation(fields: [templateItemId], references: [id], onDelete: SetNull)
  destinationSubAccount   BudgetEnvelope?   @relation(fields: [destinationSubAccountId], references: [id], onDelete: SetNull)

  @@index([planId, sortOrder])
  @@index([templateItemId])
  @@index([destinationSubAccountId])
}

model ExpenseType {
  id        String         @id @default(cuid())
  budgetId  String
  label     String
  sortOrder Int            @default(0)
  isActive  Boolean        @default(true)
  budget    BudgetEnvelope @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  expenses  Expense[]

  @@unique([budgetId, label])
}

model Transaction {
  id                      String                 @id @default(cuid())
  workspaceId             String
  accountId               String
  budgetId                String?
  groupId                 String?
  kind                    String
  direction               String
  date                    DateTime
  amountCents             Int
  subject                 String
  details                 String?
  notes                   String?                @db.NVarChar(Max)
  isSynced                Boolean                @default(false)
  isFromFamily            Boolean                @default(false)
  externalRef             String?
  postingGroupId          String?                @db.NVarChar(191)
  creditCardTransactionId String?
  receivableId            String?
  reversalOfId            String?
  voidedAt                DateTime?
  voidedByUserId          String?                @db.NVarChar(191)
  voidReason              String?                @db.NVarChar(500)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  workspace               Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account                 FinancialAccount       @relation(fields: [accountId], references: [id], onDelete: NoAction)
  budget                  BudgetEnvelope?        @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  group                   TransactionGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  expense                 Expense?
  creditCardLinks         CreditCardTxnLink[]
  postingGroup            PostingGroup?          @relation(fields: [postingGroupId], references: [id], onDelete: NoAction)
  creditCardTransaction   CreditCardTransaction? @relation(fields: [creditCardTransactionId], references: [id], onDelete: SetNull)
  receivable              Receivable?            @relation(fields: [receivableId], references: [id], onDelete: SetNull)
  reversalOf              Transaction?           @relation("TransactionReversal", fields: [reversalOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversals               Transaction[]          @relation("TransactionReversal")
  migrationMap            LegacyRecordLink?

  @@unique([workspaceId, id])
  @@index([workspaceId, date])
  @@index([accountId, date])
  @@index([workspaceId, budgetId, date])
  @@index([workspaceId, groupId, date])
  @@index([workspaceId, date, createdAt, id])
  @@index([workspaceId, direction, date])
  @@index([workspaceId, budgetId, direction, date])
  @@index([workspaceId, accountId, date])
  @@index([postingGroupId])
  @@index([creditCardTransactionId])
  @@index([receivableId])
  @@index([reversalOfId])
}

model AskNestTurn {
  id               String          @id @default(cuid())
  workspaceId      String
  userId           String
  question         String          @db.NVarChar(Max)
  answerJson       String          @db.NVarChar(Max)
  pagePath         String
  inputTokens Int?
  outputTokens Int?
  totalTokens Int?
  diagnosticsJson  String?         @db.NVarChar(Max)
  toolCallCount    Int             @default(0)
  emptyResultCount Int             @default(0)
  durationMs       Int?
  feedbackRating String?
  feedbackReason   String?
  feedbackAt       DateTime?
  createdAt        DateTime        @default(now())
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  memories         AskNestMemory[]

  @@index([workspaceId, userId, createdAt])
  @@index([createdAt, totalTokens])
  @@index([feedbackRating, createdAt])
}

model AskNestMemory {
  id              String       @id @default(cuid())
  workspaceId     String
  userId          String
  ownerHash       String       @db.VarChar(64)
  keyHash         String       @db.VarChar(64)
  kind            String
  key             String
  content         String       @db.NVarChar(1000)
  sourceTurnId    String?
  confidence      Float        @default(1)
  status          String       @default("ACTIVE")
  lastConfirmedAt DateTime?
  expiresAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceTurn      AskNestTurn? @relation(fields: [sourceTurnId], references: [id], onDelete: SetNull)

  @@unique([ownerHash, keyHash])
  @@index([ownerHash, status, updatedAt])
  @@index([sourceTurnId])
}

model AskNestUsageDaily {
  id               String    @id @default(cuid())
  day              String    @db.VarChar(10)
  workspaceId      String
  userId           String
  turnCount        Int       @default(0)
  trackedTurnCount Int       @default(0)
  inputTokens      Int       @default(0)
  outputTokens     Int       @default(0)
  totalTokens      Int       @default(0)
  toolCallCount    Int       @default(0)
  emptyResultCount Int       @default(0)
  totalDurationMs  Int       @default(0)
  feedbackCount    Int       @default(0)
  helpfulCount     Int       @default(0)
  notHelpfulCount  Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([day, workspaceId, userId])
  @@index([day])
  @@index([userId, day])
  @@index([workspaceId, day])
}

model PostingGroup {
  id             String         @id @default(cuid()) @db.NVarChar(191)
  workspaceId    String         @db.NVarChar(191)
  operation      String         @db.NVarChar(120)
  sourceType     String?        @db.NVarChar(80)
  sourceId       String?        @db.NVarChar(191)
  actorUserId    String?        @db.NVarChar(191)
  idempotencyKey String         @db.NVarChar(191)
  status         String         @default("POSTED") @db.NVarChar(40)
  reversalOfId   String?        @db.NVarChar(191)
  reason         String?        @db.NVarChar(500)
  createdAt      DateTime       @default(now())
  reversedAt     DateTime?
  transactions   Transaction[]
  receivables    Receivable[]
  reversalOf     PostingGroup?  @relation("PostingGroupReversal", fields: [reversalOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversals      PostingGroup[] @relation("PostingGroupReversal")

  @@unique([workspaceId, operation, idempotencyKey])
  @@index([workspaceId, sourceType, sourceId])
  @@index([reversalOfId])
}

model IdempotencyRecord {
  id             String    @id @default(cuid()) @db.NVarChar(191)
  workspaceId    String    @db.NVarChar(191)
  operation      String    @db.NVarChar(120)
  idempotencyKey String    @db.NVarChar(191)
  requestHash    String    @db.NVarChar(64)
  status         String    @default("IN_PROGRESS") @db.NVarChar(40)
  postingGroupId String?   @db.NVarChar(191)
  resultJson     String?   @db.NVarChar(Max)
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@unique([workspaceId, operation, idempotencyKey])
  @@index([workspaceId, createdAt])
}

model TransactionGroup {
  id           String         @id @default(cuid())
  workspaceId  String
  budgetId     String
  name         String
  icon         String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  budget       BudgetEnvelope @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([workspaceId, id])
  @@index([workspaceId, budgetId, updatedAt])
}

model Expense {
  id            String      @id @default(cuid())
  transactionId String      @unique
  expenseTypeId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  expenseType   ExpenseType @relation(fields: [expenseTypeId], references: [id], onDelete: NoAction)
}

model CreditCardAccount {
  id                  String                  @id @default(cuid())
  workspaceId         String
  cardName            String
  bankName            String?
  themeKey            String?
  last4Digit          String
  expiryMonth         Int?
  expiryYear          Int?
  statementDay        Int
  paymentDueDay       Int
  bonusLimitCents     Int?
  bonusStatementCents Int?
  notes               String?
  isFullySynced       Boolean                 @default(false)
  fullySyncedDate     DateTime?
  isActive            Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  workspace           Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions        CreditCardTxnLink[]
  reward              CreditCardReward?
  ccTransactions      CreditCardTransaction[]
  alertStagings       CardAlertStaging[]

  @@unique([workspaceId, cardName])
  @@unique([workspaceId, id])
  @@index([workspaceId, isActive])
}

model CreditCardTxnLink {
  id                      String                 @id @default(cuid())
  creditCardId            String
  transactionId           String
  creditCardTransactionId String?
  cardNameSnapshot        String?
  cardNoEnding            String?
  txDate                  DateTime
  isProcessed             Boolean                @default(false)
  interfacedAt            DateTime?
  creditCard              CreditCardAccount      @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  transaction             Transaction            @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  creditCardTransaction   CreditCardTransaction? @relation(fields: [creditCardTransactionId], references: [id], onDelete: SetNull)

  @@unique([creditCardId, transactionId])
  @@index([txDate])
  @@index([creditCardTransactionId])
}

model Receivable {
  id                 String            @id @default(cuid())
  workspaceId        String
  accountId          String?
  budgetId           String?
  statementMonthId   String?
  title              String
  amountCents        Int
  date               DateTime
  transactionDate    DateTime?
  isMom              Boolean           @default(false)
  isFamily           Boolean           @default(false)
  status             String            @default("OPEN")
  remarkTogether     String?
  notes              String?           @db.NVarChar(Max)
  fromUserId         String?
  toUserId           String?
  sourceWorkspaceId  String?
  sourceAccountId    String?
  sourceBudgetId     String?
  postingGroupId     String?            @db.NVarChar(191)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account            FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  budget             BudgetEnvelope?   @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  statementMonth     Month?            @relation(fields: [statementMonthId], references: [id], onDelete: SetNull)
  ledgerTransactions Transaction[]
  postingGroup       PostingGroup?     @relation(fields: [postingGroupId], references: [id], onDelete: NoAction)
  fromUser           User?             @relation("ReceivableFrom", fields: [fromUserId], references: [id], onDelete: NoAction)
  toUser             User?             @relation("ReceivableTo", fields: [toUserId], references: [id], onDelete: NoAction)

  @@unique([workspaceId, id])
  @@index([workspaceId, status])
  @@index([sourceWorkspaceId, sourceBudgetId, status])
  @@index([postingGroupId])
}

model SalaryEntry {
  id          String    @id @default(cuid())
  workspaceId String
  date        DateTime
  amountCents Int
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model UsdAccountEntry {
  id           String    @id @default(cuid())
  workspaceId  String
  date         DateTime
  amountCents  Int
  isHide       Boolean   @default(false)
  description  String?
  exchangeRate Decimal   @db.Decimal(10, 4)
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model UsdInvestmentEntry {
  id             String    @id @default(cuid())
  workspaceId    String
  date           DateTime
  amountCents    Int
  principalCents Int
  createdAt      DateTime  @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model NoteList {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  subject     String?
  amountCents Int?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  notes       Note[]
}

model Note {
  id          String    @id @default(cuid())
  workspaceId String
  noteListId  String?
  createdById String?
  title       String
  content     String
  isDeleted   Boolean   @default(false)
  isList      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  modifiedAt  DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  noteList    NoteList? @relation(fields: [noteListId], references: [id], onDelete: SetNull)
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
}

model MileProgram {
  id                String                 @id @default(cuid())
  workspaceId       String
  frequentFlyerId   String?
  date              DateTime
  miles             Int
  balanceMiles      Int
  expiryDate        DateTime?
  title             String?
  firstRedeemedDate DateTime?
  createdAt         DateTime               @default(now())
  workspace         Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  frequentFlyer     FrequentFlyerAccount?  @relation("FrequentFlyerMilePrograms", fields: [frequentFlyerId], references: [id], onDelete: SetNull)
  redemptionDetails MileRedemptionDetail[]

  @@index([workspaceId, frequentFlyerId, date])
}

model MileRedemption {
  id                 String                 @id @default(cuid())
  workspaceId        String
  frequentFlyerId    String?
  redemptionTitle    String
  totalMilesRedeemed Int
  dateTime           DateTime
  createdAt          DateTime               @default(now())
  workspace          Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  frequentFlyer      FrequentFlyerAccount?  @relation("FrequentFlyerMileRedemptions", fields: [frequentFlyerId], references: [id], onDelete: SetNull)
  details            MileRedemptionDetail[]

  @@index([workspaceId, frequentFlyerId, dateTime])
}

model MileRedemptionDetail {
  id            String         @id @default(cuid())
  redemptionId  String
  milesFileId   String
  milesRedeemed Int
  redemption    MileRedemption @relation(fields: [redemptionId], references: [id], onDelete: Cascade)
  milesFile     MileProgram    @relation(fields: [milesFileId], references: [id], onDelete: NoAction)

  @@index([redemptionId])
}

model LegacyRecordLink {
  id            String       @id @default(cuid())
  system        String       @default("LEGACY_NEST_V1")
  sourceTable   String
  sourceId      String
  targetModel   String
  targetId      String
  migratedAt    DateTime     @default(now())
  checksum      String?
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([system, sourceTable, sourceId])
  @@index([targetModel, targetId])
}

// Rewards & Loyalty Program Models
model FrequentFlyerAccount {
  id                  String            @id @default(cuid())
  workspaceId         String
  programName         String
  airlineName         String
  accountNumber       String?
  currentMiles        Int               @default(0)
  targetMiles         Int?
  expiryWarning       Int?              @default(6) // months before expiry to warn
  mileNeverExpire     Boolean           @default(false)
  validityPeriodYears Int               @default(3)
  notes               String?
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversions         PointConversion[]
  milePrograms        MileProgram[]     @relation("FrequentFlyerMilePrograms")
  mileRedemptions     MileRedemption[]  @relation("FrequentFlyerMileRedemptions")

  @@unique([workspaceId, programName])
  @@unique([workspaceId, id])
  @@index([workspaceId, isActive])
}

model HotelRewardAccount {
  id            String    @id @default(cuid())
  workspaceId   String
  programName   String
  hotelBrand    String
  accountNumber String?
  currentPoints Int       @default(0)
  targetPoints  Int?
  centsPerPoint Decimal   @default(0) @db.Decimal(19, 8)
  notes         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, programName])
  @@unique([workspaceId, id])
  @@index([workspaceId, isActive])
}

model CreditCardReward {
  id               String            @id @default(cuid())
  workspaceId      String
  creditCardId     String
  currentPoints    Int               @default(0)
  pointsValueCents Int? // estimated cash value in cents
  lastUpdated      DateTime          @default(now())
  createdAt        DateTime          @default(now())
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creditCard       CreditCardAccount @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  conversions      PointConversion[]

  @@unique([creditCardId])
  @@unique([workspaceId, id])
  @@index([workspaceId])
}

model PointConversion {
  id                 String                @id @default(cuid())
  workspaceId        String
  creditCardRewardId String?
  frequentFlyerId    String?
  fromPoints         Int
  toMiles            Int
  conversionRate     Decimal               @db.Decimal(19, 8) // miles per point (e.g., 0.625 for 5:8 ratio)
  description        String?
  createdAt          DateTime              @default(now())
  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creditCardReward   CreditCardReward?     @relation(fields: [creditCardRewardId], references: [id], onDelete: SetNull)
  frequentFlyer      FrequentFlyerAccount? @relation(fields: [frequentFlyerId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@index([workspaceId])
  @@index([creditCardRewardId])
  @@index([frequentFlyerId])
}

model CreditCardTransaction {
  id                 String              @id @default(cuid())
  workspaceId        String
  creditCardId       String
  transactionDate    DateTime // Date of the transaction
  paymentDueDate     DateTime? // When payment is due
  statementMonth     Int // Month of statement (1-12)
  statementYear      Int // Year of statement
  amountCents        Int // Transaction amount
  subject            String // Transaction description/subject
  isInstallment      Boolean             @default(false)
  installmentNo      Int? // Current installment number
  totalInstallments  Int? // Total number of installments
  isAllocated        Boolean             @default(false) // Whether allocated to budget
  budgetId           String? // Linked budget if allocated
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creditCard         CreditCardAccount   @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  alertStagings      CardAlertStaging[]
  ledgerTransactions Transaction[]
  ledgerLinks        CreditCardTxnLink[]

  @@unique([workspaceId, id])
  @@index([workspaceId])
  @@index([creditCardId])
  @@index([statementYear, statementMonth])
  @@index([transactionDate])
  @@index([workspaceId, creditCardId, statementYear, statementMonth, transactionDate])
  @@index([workspaceId, statementYear, statementMonth, isAllocated])
  @@index([workspaceId, isAllocated, transactionDate])
  @@index([workspaceId, paymentDueDate])
  @@index([workspaceId, creditCardId, transactionDate])
}

model CardAlertStaging {
  id                  String                 @id @default(cuid())
  workspaceId         String
  source              String                 @default("EMAIL")
  bankName            String?
  transactionRef      String?
  rawSubject          String?
  rawBody             String                 @db.NVarChar(Max)
  sourceMessageKey    String?                @db.VarChar(64)
  transactionKey      String?                @db.VarChar(64)
  contentHash         String?                @db.VarChar(64)
  currency            String?
  amountCents         Int?
  transactionDate     DateTime?
  merchant            String?
  cardLast4           String?
  parseStatus         String                 @default("PENDING")
  processingStartedAt DateTime?
  failureReason       String?
  creditCardId        String?
  creditTransactionId String?
  createdAt           DateTime               @default(now())
  processedAt         DateTime?
  workspace           Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creditCard          CreditCardAccount?     @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  creditTransaction   CreditCardTransaction? @relation(fields: [creditTransactionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, parseStatus])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, transactionRef])
  @@index([sourceMessageKey])
  @@index([transactionKey])
  @@index([creditTransactionId])
}

model GmailIntegration {
  id            String    @id @default(cuid())
  workspaceId   String
  userId        String
  email         String
  accessToken   String?   @db.NVarChar(Max)
  refreshToken  String?   @db.NVarChar(Max)
  tokenType     String?
  scope         String?   @db.NVarChar(Max)
  expiryDate    DateTime?
  isActive      Boolean   @default(true)
  lastSyncedAt  DateTime?
  lastHistoryId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@unique([workspaceId, id])
  @@index([workspaceId, isActive])
}

model BackgroundJob {
  id                String    @id @default(cuid())
  type              String
  key               String?
  activeScopeKey    String?   @db.VarChar(64)
  idempotencyKey    String?   @db.VarChar(64)
  status            String    @default("PENDING")
  workspaceId       String?
  userId            String?
  progress          Int       @default(0)
  total             Int?
  current           Int?
  message           String?
  payloadJson       String?   @db.NVarChar(Max)
  checkpointJson    String?   @db.NVarChar(Max)
  resultJson        String?   @db.NVarChar(Max)
  errorCode         String?
  error             String?   @db.NVarChar(Max)
  attempts          Int       @default(0)
  retryCount        Int       @default(0)
  maxAttempts       Int       @default(5)
  duplicateCount    Int       @default(0)
  availableAt       DateTime  @default(now())
  leaseToken        String?
  lockedAt          DateTime?
  leaseExpiresAt    DateTime?
  cancelRequestedAt DateTime?
  deadLetteredAt    DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([type, status, createdAt])
  @@index([key, status])
  @@index([activeScopeKey])
  @@index([idempotencyKey])
  @@index([status, availableAt])
  @@index([leaseExpiresAt])
}

model MassiveMarketDataCache {
  cacheKey    String   @id @db.NVarChar(450)
  payloadJson String   @db.NVarChar(Max)
  fetchedAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

model MassiveApiThrottle {
  provider      String   @id @db.NVarChar(100)
  nextAllowedAt DateTime
  updatedAt     DateTime @updatedAt
}

model SerpApiNewsCache {
  cacheKey    String   @id @db.NVarChar(450)
  payloadJson String   @db.NVarChar(Max)
  fetchedAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

model SerpApiQuota {
  provider      String   @id @db.NVarChar(100)
  windowKey     String   @db.NVarChar(32)
  requestCount  Int      @default(0)
  nextAllowedAt DateTime
  updatedAt     DateTime @updatedAt
}

model InAppNotification {
  id           String     @id @default(cuid())
  userId       String
  workspaceId  String?
  type         String
  dedupeKey    String
  title        String
  message      String     @db.NVarChar(Max)
  href         String?
  metadataJson String?    @db.NVarChar(Max)
  readAt       DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, workspaceId, readAt, updatedAt])
  @@index([workspaceId, type])
}

model PasskeyCredential {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String?
  deviceType   String
  backedUp     Boolean   @default(false)
  name         String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model WebAuthnChallenge {
  id        String   @id @default(cuid())
  userId    String?
  purpose   String
  challenge String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@index([purpose, expiresAt])
}

model PushSubscription {
  id             String   @id @default(cuid())
  userId         String
  endpoint       String   @unique @db.NVarChar(1000)
  p256dh         String   @db.NVarChar(1000)
  auth           String   @db.NVarChar(1000)
  expirationTime BigInt?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}
