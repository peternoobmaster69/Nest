{
  "version": 1,
  "projectKey": "nest",
  "projectName": "Nest",
  "gateName": "Nest strict AI",
  "profileName": "Nest comprehensive",
  "baseProfiles": ["Sonar way comprehensive", "Sonar way"],
  "languages": ["js", "ts", "css", "web", "json", "yaml", "docker", "secrets", "text"],
  "additionalRuleFilters": [
    { "impactSoftwareQualities": "SECURITY,RELIABILITY" },
    { "types": "SECURITY_HOTSPOT" }
  ],
  "explicitRules": {
    "js": ["javascript:S1291"],
    "ts": ["typescript:S1291"]
  },
  "settings": {
    "sonar.qualitygate.ignoreSmallChanges": "false"
  },
  "conditions": [
    { "metric": "violations", "op": "GT", "error": "0" },
    { "metric": "new_violations", "op": "GT", "error": "0" },
    { "metric": "accepted_issues", "op": "GT", "error": "0" },
    { "metric": "new_accepted_issues", "op": "GT", "error": "0" },
    { "metric": "coverage", "op": "LT", "error": "100" },
    { "metric": "new_coverage", "op": "LT", "error": "100" },
    { "metric": "line_coverage", "op": "LT", "error": "100" },
    { "metric": "new_line_coverage", "op": "LT", "error": "100" },
    { "metric": "branch_coverage", "op": "LT", "error": "100" },
    { "metric": "new_branch_coverage", "op": "LT", "error": "100" },
    { "metric": "duplicated_lines_density", "op": "GT", "error": "0" },
    { "metric": "new_duplicated_lines_density", "op": "GT", "error": "0" },
    { "metric": "security_hotspots_reviewed", "op": "LT", "error": "100" },
    { "metric": "new_security_hotspots_reviewed", "op": "LT", "error": "100" }
  ]
}
