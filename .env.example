# Database.
SHADOW_DATABASE_URL=""
# Optional split form when DATABASE_URL contains only the SQL Server hostname.
AZURE_SQL_SERVER=""
AZURE_SQL_DATABASE=""
AZURE_SQL_USER=""
AZURE_SQL_PASSWORD=""
AZURE_SQL_ENCRYPT="true"
AZURE_SQL_TRUST_SERVER_CERTIFICATE="false"
DATABASE_URL=""

# Application and authentication.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
WEBAUTHN_RP_NAME="Nest"
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:3000"

# OAuth providers. Disabled when their pairs are empty.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
# Leave empty to derive the Gmail callback from NEXTAUTH_URL.
GMAIL_REDIRECT_URI=""
GMAIL_SYNC_MESSAGES_PER_SLICE="50"
GMAIL_SYNC_SLICES_PER_INVOCATION="4"

# Versioned AES-256-GCM key for integration credentials.
INTEGRATION_ENCRYPTION_KEY=""
INTEGRATION_ENCRYPTION_KEY_VERSION="v1"
# Retired version -> base64 key; retain only while old envelopes exist.
INTEGRATION_ENCRYPTION_PREVIOUS_KEYS="{}"

# Scheduler authentication. Required in production.
CRON_SECRET=""

# Optional email delivery and reminder presentation.
AZURE_COMMUNICATION_EMAIL_CONNECTION_STRING=""
AZURE_EMAIL_SENDER=""
CREDIT_CARD_REMINDER_CURRENCY="SGD"
PAYMENT_REMINDER_MAX_DELIVERIES_PER_RUN="100"

# Optional Web Push notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Ask Nest model configuration. The first three values are required to use Ask Nest.
AI_WORKLOAD_ENDPOINT=""
AI_WORKLOAD_API_KEY=""
AI_WORKLOAD_MODEL=""
# Optional USD rates used only for admin cost estimates.
AI_WORKLOAD_INPUT_COST_PER_1M_USD=""
AI_WORKLOAD_OUTPUT_COST_PER_1M_USD=""
ASK_NEST_HISTORY_RETENTION_DAYS="90"

# Optional database retention windows. Values are days; work is bounded per run.
DATA_RETENTION_BATCH_SIZE="250"
BACKGROUND_JOB_PAYLOAD_RETENTION_DAYS="14"
BACKGROUND_JOB_RETENTION_DAYS="90"
CARD_ALERT_BODY_RETENTION_DAYS="7"
INVITE_RETENTION_DAYS="30"
READ_NOTIFICATION_RETENTION_DAYS="90"
NOTIFICATION_RETENTION_DAYS="365"
AUDIT_LOG_RETENTION_DAYS="730"
LOGIN_SESSION_RETENTION_DAYS="90"

# Optional Azure AI Search knowledge retrieval. Both gates must be true.
ASK_NEST_SEARCH_ENABLED="false"
ASK_NEST_SEARCH_EVAL_PASS="false"
AZURE_SEARCH_ENDPOINT=""
AZURE_SEARCH_INDEX=""
AZURE_SEARCH_SEMANTIC_CONFIGURATION="ask-nest-semantic"
# Optional local credential; leave empty to use managed identity.
AZURE_SEARCH_QUERY_KEY=""

# Optional public market data and news providers.
MASSIVE_API_BASE_URL="https://api.massive.com"
MASSIVE_API_KEY=""
SERPAPI_BASE_URL="https://serpapi.com"
SERPAPI_API_KEY=""
SERPAPI_MONTHLY_REQUEST_LIMIT="200"

# Administration and brand assets.
ADMIN=""
# API docs are disabled in production unless explicitly enabled; production access is admin-only.
ENABLE_API_DOCS="false"
NEXT_PUBLIC_LOGO_DEV_TOKEN=""

# Keep false on Vercel/Azure; enable only behind another trusted proxy.
TRUST_PROXY_HEADERS="false"
# Optional ISO country header injected and overwritten by a trusted proxy.
# Azure Front Door can populate this from its geo_country server variable.
TRUSTED_COUNTRY_HEADER=""

# Test-only integration switches.
RUN_PHASE1_DB_TESTS="false"
RUN_PHASE4_DB_TESTS="false"
