# Database. DATABASE_URL may be a complete Prisma SQL Server URL or the server host.
DATABASE_URL="your-server.database.windows.net"
AZURE_SQL_SERVER="your-server.database.windows.net"
AZURE_SQL_DATABASE="nest"
AZURE_SQL_USER=""
AZURE_SQL_PASSWORD=""
AZURE_SQL_ENCRYPT="true"
AZURE_SQL_TRUST_SERVER_CERTIFICATE="false"

# Application and authentication.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
ADMIN=""

# Optional OAuth providers.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
GMAIL_REDIRECT_URI=""

# Passkeys.
WEBAUTHN_RP_NAME="Nest"
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:3000"

# Email. Configure SMTP, Azure Communication Services, or both.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
AZURE_COMMUNICATION_EMAIL_CONNECTION_STRING=""
AZURE_EMAIL_SENDER=""

# Scheduler authentication. Use separate random values in production.
CRON_SECRET=""
CREDIT_CARD_REMINDER_CURRENCY="SGD"
APP_URL="http://localhost:3000"

# 32-byte base64 key for AES-256-GCM encrypted card fields.
CARD_ENCRYPTION_KEY=""

# Only enable behind a trusted proxy that overwrites forwarded client-IP headers.
TRUST_PROXY_HEADERS="false"

# Ask Nest model and retention configuration.
AI_WORKLOAD_ENDPOINT=""
AI_WORKLOAD_API_KEY=""
AI_WORKLOAD_MODEL=""
AI_WORKLOAD_INPUT_COST_PER_1M_USD=""
AI_WORKLOAD_OUTPUT_COST_PER_1M_USD=""
ASK_NEST_HISTORY_RETENTION_DAYS="90"

# Optional Azure AI Search retrieval.
ASK_NEST_SEARCH_ENABLED="false"
ASK_NEST_SEARCH_EVAL_PASS="false"
AZURE_SEARCH_ENDPOINT=""
AZURE_SEARCH_INDEX="ask-nest-knowledge"
AZURE_SEARCH_SEMANTIC_CONFIGURATION="ask-nest-semantic"
AZURE_SEARCH_QUERY_KEY=""

# Optional market data and public news.
MASSIVE_API_BASE_URL="https://api.massive.com"
MASSIVE_API_KEY=""
SERPAPI_BASE_URL="https://serpapi.com"
SERPAPI_API_KEY=""
SERPAPI_MONTHLY_REQUEST_LIMIT="200"

# Optional web push and bank-logo provider.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
NEXT_PUBLIC_LOGO_DEV_TOKEN=""

# Integration-test opt-in; leave disabled for normal development.
RUN_PHASE1_DB_TESTS="false"
